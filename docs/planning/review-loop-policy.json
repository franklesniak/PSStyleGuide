{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/franklesniak/PSStyleGuide/docs/planning/review-loop-policy.json",
  "title": "Coding-agent-loop compact state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "current_task",
    "completed",
    "updated_utc"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "plan": {
      "const": "docs/planning/action-items-2026-08-30.md"
    },
    "current_task": {
      "$ref": "#/$defs/taskState"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "updated_utc": {
      "$ref": "#/$defs/rfc3339"
    }
  },
  "$defs": {
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "risk",
        "repository",
        "branch",
        "base",
        "head",
        "last_gate",
        "next_action",
        "blocker"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "pending",
            "active",
            "validating",
            "ready",
            "waiting_external",
            "waiting_human",
            "complete",
            "blocked"
          ]
        },
        "risk": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_gate": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/reviewState"
        }
      }
    },
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewInput",
        "mutationClass",
        "reviewRequests",
        "copilotResults",
        "codexResults",
        "publicMutation",
        "metrics",
        "commentPublications"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "reviewInput": {
          "$ref": "#/$defs/reviewInput"
        },
        "mutationClass": {
          "$ref": "#/$defs/mutationClass"
        },
        "materialReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewRequests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewRequest"
          }
        },
        "copilotResults": {
          "$ref": "#/$defs/reviewerResults"
        },
        "codexResults": {
          "$ref": "#/$defs/reviewerResults"
        },
        "publicMutation": {
          "$ref": "#/$defs/publicMutation"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "commentPublications": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mutationClass": {
                "const": "MATERIAL_SCOPE_BEHAVIOR_RISK"
              }
            }
          },
          "then": {
            "required": [
              "materialReason"
            ],
            "properties": {
              "materialReason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "reviewerResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submittedReviews",
        "conversationComments"
      ],
      "properties": {
        "submittedReviews": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conversationComments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$"
    },
    "reviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "diffSha256",
        "bodySha256",
        "scope",
        "behavior",
        "risk"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/sha1"
        },
        "tree": {
          "$ref": "#/$defs/sha1"
        },
        "diffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bodySha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mutationClass": {
      "enum": [
        "CODE_OR_DIFF",
        "MATERIAL_SCOPE_BEHAVIOR_RISK",
        "NON_MATERIAL_FACT",
        "RESULT_OR_STATE",
        "COMMENT_ONLY"
      ]
    },
    "reviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "reviewInputKey",
        "head",
        "requestedAt",
        "terminal",
        "baselineReviewNodeIds",
        "baselineConversationComments"
      ],
      "properties": {
        "channel": {
          "enum": [
            "copilot",
            "codex"
          ]
        },
        "reviewInputKey": {
          "$ref": "#/$defs/sha256"
        },
        "head": {
          "$ref": "#/$defs/sha1"
        },
        "requestedAt": {
          "$ref": "#/$defs/rfc3339"
        },
        "terminal": {
          "type": "boolean"
        },
        "baselineReviewNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "baselineConversationComments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commentBaseline"
          }
        }
      }
    },
    "commentBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "updatedAt"
      ],
      "properties": {
        "nodeId": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "$ref": "#/$defs/rfc3339"
        }
      }
    },
    "publicMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "nativeResponseAccepted",
        "readbackMatched",
        "retryAllowed",
        "localRecordSucceeded"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_ATTEMPTED",
            "NOT_EXECUTED",
            "AMBIGUOUS",
            "CONFIRMED"
          ]
        },
        "nativeResponseAccepted": {
          "type": "boolean"
        },
        "readbackMatched": {
          "type": "boolean"
        },
        "retryAllowed": {
          "type": "boolean"
        },
        "localRecordSucceeded": {
          "type": "boolean"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerRequestsPerHead",
        "bodyEditsAfterReviewBegan",
        "sameHeadRerequestReasons",
        "cleanReviewRecognitionMilliseconds",
        "cleanPairToMergeMilliseconds"
      ],
      "properties": {
        "reviewerRequestsPerHead": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bodyEditsAfterReviewBegan": {
          "type": "integer",
          "minimum": 0
        },
        "sameHeadRerequestReasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "material"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "material": {
                "type": "boolean"
              }
            }
          }
        },
        "cleanReviewRecognitionMilliseconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cleanPairToMergeMilliseconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
