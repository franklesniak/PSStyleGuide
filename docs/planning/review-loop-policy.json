{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/franklesniak/PSStyleGuide/docs/planning/review-loop-policy.json",
  "title": "Coding-agent-loop compact state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan",
    "current_task",
    "predecessor_outputs",
    "completed",
    "updated_utc"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "plan": {
      "const": "docs/planning/action-items-2026-08-30.md"
    },
    "current_task": {
      "$ref": "#/$defs/taskState"
    },
    "predecessor_outputs": {
      "$ref": "#/$defs/predecessorOutputs"
    },
    "completed": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 402
      },
      "maxItems": 402,
      "uniqueItems": true
    },
    "updated_utc": {
      "$ref": "#/$defs/rfc3339"
    }
  },
  "$defs": {
    "taskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "state",
        "risk",
        "repository",
        "branch",
        "base",
        "head",
        "last_gate",
        "next_action",
        "blocker"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 402
        },
        "state": {
          "enum": [
            "pending",
            "active",
            "validating",
            "ready",
            "waiting_external",
            "waiting_human",
            "complete",
            "blocked"
          ]
        },
        "risk": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha1"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha1"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_gate": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "blocker": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "$ref": "#/$defs/reviewState"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "number": {
                "enum": [
                  6,
                  15,
                  25,
                  34,
                  45,
                  54,
                  63,
                  74,
                  83,
                  92,
                  101,
                  110,
                  119,
                  130,
                  139,
                  148,
                  158,
                  167,
                  176,
                  186,
                  195,
                  204,
                  216,
                  227,
                  237,
                  246,
                  255,
                  264,
                  273,
                  282,
                  291,
                  300,
                  309,
                  317,
                  328,
                  337,
                  346,
                  355,
                  364,
                  373,
                  385,
                  396
                ]
              },
              "state": {
                "not": {
                  "const": "pending"
                }
              }
            },
            "required": [
              "number",
              "state"
            ]
          },
          "then": {
            "required": [
              "review"
            ]
          }
        }
      ]
    },
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "reviewInput",
        "mutationClass",
        "reviewRequests",
        "supersededReviewInputs",
        "copilotResults",
        "codexResults",
        "publicMutation",
        "metrics",
        "commentPublications"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "reviewInput": {
          "$ref": "#/$defs/reviewInput"
        },
        "mutationClass": {
          "$ref": "#/$defs/mutationClass"
        },
        "materialReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewRequests": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reviewRequest"
          }
        },
        "supersededReviewInputs": {
          "$ref": "#/$defs/supersededReviewInputs"
        },
        "copilotResults": {
          "$ref": "#/$defs/reviewerResults"
        },
        "codexResults": {
          "$ref": "#/$defs/reviewerResults"
        },
        "publicMutation": {
          "$ref": "#/$defs/publicMutation"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "commentPublications": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mutationClass": {
                "const": "MATERIAL_SCOPE_BEHAVIOR_RISK"
              }
            }
          },
          "then": {
            "required": [
              "materialReason"
            ],
            "properties": {
              "materialReason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "reviewerResults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submittedReviews",
        "conversationComments"
      ],
      "properties": {
        "submittedReviews": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "conversationComments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:[0-9]{4})-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$"
    },
    "reviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "tree",
        "diffSha256",
        "bodySha256",
        "scope",
        "behavior",
        "risk"
      ],
      "properties": {
        "head": {
          "$ref": "#/$defs/sha1"
        },
        "tree": {
          "$ref": "#/$defs/sha1"
        },
        "diffSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bodySha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "behavior": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "risk": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "mutationClass": {
      "enum": [
        "CODE_OR_DIFF",
        "MATERIAL_SCOPE_BEHAVIOR_RISK",
        "NON_MATERIAL_FACT",
        "RESULT_OR_STATE",
        "COMMENT_ONLY"
      ]
    },
    "reviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "reviewInputKey",
        "head",
        "requestedAt",
        "confirmed",
        "terminal",
        "baselineRequestEventIds",
        "baselineReviewNodeIds",
        "baselineReviewRunIds",
        "baselineConversationComments"
      ],
      "properties": {
        "channel": {
          "enum": [
            "copilot",
            "codex"
          ]
        },
        "reviewInputKey": {
          "$ref": "#/$defs/sha256"
        },
        "head": {
          "$ref": "#/$defs/sha1"
        },
        "requestedAt": {
          "$ref": "#/$defs/rfc3339"
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "readyAt": {
          "$ref": "#/$defs/rfc3339"
        },
        "confirmed": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        },
        "terminalResultRef": {
          "$ref": "#/$defs/terminalResultRef"
        },
        "baselineRequestEventIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "baselineReviewNodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "baselineReviewRunIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "baselineConversationComments": {
          "$ref": "#/$defs/commentBaselines"
        },
        "terminalDisposition": {
          "$ref": "#/$defs/terminalDisposition"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "readyAt"
            ]
          },
          "then": {
            "properties": {
              "channel": {
                "const": "copilot"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": false
              },
              "terminal": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "terminalDisposition"
            ]
          }
        },
        {
          "if": {
            "required": [
              "terminalDisposition"
            ]
          },
          "then": {
            "properties": {
              "confirmed": {
                "const": false
              },
              "terminal": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmed": {
                "const": true
              },
              "terminal": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "terminalResultRef"
            ]
          }
        },
        {
          "if": {
            "required": [
              "terminalResultRef"
            ]
          },
          "then": {
            "properties": {
              "confirmed": {
                "const": true
              },
              "terminal": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "terminalResultRef"
            ],
            "properties": {
              "channel": {
                "const": "copilot"
              }
            }
          },
          "then": {
            "properties": {
              "terminalResultRef": {
                "properties": {
                  "kind": {
                    "const": "submitted-review"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "terminalResultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "observedAt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "submitted-review",
            "conversation-comment"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observedAt": {
          "$ref": "#/$defs/rfc3339"
        }
      }
    },
    "terminalDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "recordedAt",
        "authority",
        "reason"
      ],
      "properties": {
        "state": {
          "const": "REPOSITORY_AUTHORIZED_NON_FUNCTIONAL"
        },
        "recordedAt": {
          "$ref": "#/$defs/rfc3339"
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "commentBaselines": {
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 256
      },
      "additionalProperties": {
        "$ref": "#/$defs/rfc3339"
      }
    },
    "supersededReviewInputs": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/sha256"
      },
      "additionalProperties": {
        "$ref": "#/$defs/supersededReviewInput"
      }
    },
    "supersededReviewInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "head",
        "successorHead",
        "supersededAt",
        "reason"
      ],
      "properties": {
        "state": {
          "const": "SUPERSEDED"
        },
        "head": {
          "$ref": "#/$defs/sha1"
        },
        "successorHead": {
          "$ref": "#/$defs/sha1"
        },
        "supersededAt": {
          "$ref": "#/$defs/rfc3339"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "reviewRequestEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responseReviewerMatched",
        "requestEventMatched",
        "requestedReviewerMatched",
        "submittedReviewMatched",
        "reviewRunMatched",
        "triggerCommentMatched",
        "readbackComplete"
      ],
      "properties": {
        "responseReviewerMatched": {
          "type": "boolean"
        },
        "requestEventMatched": {
          "type": "boolean"
        },
        "requestedReviewerMatched": {
          "type": "boolean"
        },
        "submittedReviewMatched": {
          "type": "boolean"
        },
        "reviewRunMatched": {
          "type": "boolean"
        },
        "triggerCommentMatched": {
          "type": "boolean"
        },
        "readbackComplete": {
          "type": "boolean"
        }
      }
    },
    "publicMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "nativeResponseAccepted",
        "readbackMatched",
        "retryAllowed",
        "localRecordSucceeded"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_ATTEMPTED",
            "NOT_EXECUTED",
            "RECONCILING",
            "NO_EFFECT",
            "EXHAUSTED",
            "AMBIGUOUS",
            "CONFIRMED"
          ]
        },
        "nativeResponseAccepted": {
          "type": "boolean"
        },
        "readbackMatched": {
          "type": "boolean"
        },
        "retryAllowed": {
          "type": "boolean"
        },
        "localRecordSucceeded": {
          "type": "boolean"
        },
        "reviewInputKey": {
          "$ref": "#/$defs/sha256"
        },
        "channel": {
          "enum": [
            "copilot",
            "codex"
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "attemptedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/rfc3339"
            },
            {
              "type": "null"
            }
          ]
        },
        "reconciledAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/rfc3339"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "$ref": "#/$defs/reviewRequestEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "channel",
              "evidence"
            ],
            "properties": {
              "channel": {
                "const": "copilot"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "triggerCommentMatched": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "channel",
              "evidence"
            ],
            "properties": {
              "channel": {
                "const": "codex"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "responseReviewerMatched": {
                    "const": false
                  },
                  "requestEventMatched": {
                    "const": false
                  },
                  "requestedReviewerMatched": {
                    "const": false
                  },
                  "submittedReviewMatched": {
                    "const": false
                  },
                  "reviewRunMatched": {
                    "const": false
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "evidence"
            ]
          },
          "then": {
            "required": [
              "reviewInputKey",
              "channel"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "reviewInputKey"
                  ]
                },
                {
                  "required": [
                    "channel"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "RECONCILING"
              }
            }
          },
          "then": {
            "required": [
              "attemptCount",
              "attemptedAt",
              "reconciledAt",
              "evidence"
            ],
            "properties": {
              "nativeResponseAccepted": {
                "const": true
              },
              "readbackMatched": {
                "const": false
              },
              "retryAllowed": {
                "const": false
              },
              "attemptedAt": {
                "$ref": "#/$defs/rfc3339"
              },
              "reconciledAt": {
                "type": "null"
              },
              "evidence": {
                "allOf": [
                  {
                    "$ref": "#/$defs/reviewRequestEvidence"
                  },
                  {
                    "properties": {
                      "requestEventMatched": {
                        "const": false
                      },
                      "requestedReviewerMatched": {
                        "const": false
                      },
                      "submittedReviewMatched": {
                        "const": false
                      },
                      "reviewRunMatched": {
                        "const": false
                      },
                      "triggerCommentMatched": {
                        "const": false
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NO_EFFECT"
              }
            }
          },
          "then": {
            "required": [
              "attemptCount",
              "attemptedAt",
              "reconciledAt",
              "evidence"
            ],
            "properties": {
              "nativeResponseAccepted": {
                "const": true
              },
              "readbackMatched": {
                "const": false
              },
              "retryAllowed": {
                "const": true
              },
              "attemptCount": {
                "const": 1
              },
              "attemptedAt": {
                "$ref": "#/$defs/rfc3339"
              },
              "reconciledAt": {
                "$ref": "#/$defs/rfc3339"
              },
              "evidence": {
                "allOf": [
                  {
                    "$ref": "#/$defs/reviewRequestEvidence"
                  },
                  {
                    "properties": {
                      "requestEventMatched": {
                        "const": false
                      },
                      "requestedReviewerMatched": {
                        "const": false
                      },
                      "submittedReviewMatched": {
                        "const": false
                      },
                      "reviewRunMatched": {
                        "const": false
                      },
                      "triggerCommentMatched": {
                        "const": false
                      },
                      "readbackComplete": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "EXHAUSTED"
              }
            }
          },
          "then": {
            "required": [
              "attemptCount",
              "attemptedAt",
              "reconciledAt",
              "evidence"
            ],
            "properties": {
              "nativeResponseAccepted": {
                "const": true
              },
              "readbackMatched": {
                "const": false
              },
              "retryAllowed": {
                "const": false
              },
              "attemptCount": {
                "const": 2
              },
              "attemptedAt": {
                "$ref": "#/$defs/rfc3339"
              },
              "reconciledAt": {
                "$ref": "#/$defs/rfc3339"
              },
              "evidence": {
                "allOf": [
                  {
                    "$ref": "#/$defs/reviewRequestEvidence"
                  },
                  {
                    "properties": {
                      "requestEventMatched": {
                        "const": false
                      },
                      "requestedReviewerMatched": {
                        "const": false
                      },
                      "submittedReviewMatched": {
                        "const": false
                      },
                      "reviewRunMatched": {
                        "const": false
                      },
                      "triggerCommentMatched": {
                        "const": false
                      },
                      "readbackComplete": {
                        "const": true
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_ATTEMPTED"
              }
            }
          },
          "then": {
            "properties": {
              "nativeResponseAccepted": {
                "const": false
              },
              "readbackMatched": {
                "const": false
              },
              "retryAllowed": {
                "const": true
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "attemptCount"
                  ]
                },
                {
                  "required": [
                    "attemptedAt"
                  ]
                },
                {
                  "required": [
                    "reconciledAt"
                  ]
                },
                {
                  "required": [
                    "evidence"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "CONFIRMED"
              }
            }
          },
          "then": {
            "properties": {
              "nativeResponseAccepted": {
                "const": true
              },
              "readbackMatched": {
                "const": true
              },
              "retryAllowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "AMBIGUOUS"
              }
            }
          },
          "then": {
            "properties": {
              "retryAllowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "NOT_EXECUTED"
              }
            }
          },
          "then": {
            "properties": {
              "nativeResponseAccepted": {
                "const": false
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "readbackMatched": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "retryAllowed": {
                      "const": false
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "readbackMatched": {
                      "const": false
                    }
                  }
                },
                "then": {
                  "properties": {
                    "retryAllowed": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "portableJsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/portableJsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/portableJsonValue"
          }
        }
      ]
    },
    "predecessorOutputs": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^(?:[1-9][0-9]?|[1-3][0-9]{2}|40[0-2])$"
      },
      "patternProperties": {
        "^(?:[1-9][0-9]?|[1-3][0-9]{2}|40[0-2])$": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/predecessorOutput"
          }
        }
      },
      "additionalProperties": false
    },
    "predecessorOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "last_consumer_task"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/portableJsonValue"
        },
        "last_consumer_task": {
          "type": "integer",
          "minimum": 2,
          "maximum": 402
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerRequestsPerHead",
        "bodyEditsAfterReviewBegan",
        "sameHeadRerequestReasons",
        "cleanReviewRecognitionMilliseconds",
        "cleanPairToMergeMilliseconds"
      ],
      "properties": {
        "reviewerRequestsPerHead": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/sha1"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "bodyEditsAfterReviewBegan": {
          "type": "integer",
          "minimum": 0
        },
        "sameHeadRerequestReasons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "material"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "material": {
                "type": "boolean"
              }
            }
          }
        },
        "cleanReviewRecognitionMilliseconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cleanPairToMergeMilliseconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
