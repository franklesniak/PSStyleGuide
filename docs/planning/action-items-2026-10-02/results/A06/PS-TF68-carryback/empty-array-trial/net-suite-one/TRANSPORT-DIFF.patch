+"""Single finite net judgment. No execution or source modification on import."""
+import math
+
+def evaluate(record,m):
+    assert record.get('failure') is None and [x['name'] for x in record['commands']]==['B-preflight','B-aggregate','A-aggregate']
+    for item in record['commands']:
+        assert item['state']=='passed' and item['exit']==0 and not any(key in item for key in ['cleanup_failure','direct_cleanup_failure','stream_cleanup_failure','terminal_receipt_failure'])
+        assert math.isfinite(item['elapsed_seconds']) and item['elapsed_seconds']>0
+        if item['name'].endswith('-aggregate'):
+            assert item['hook_rows']==[{'name':hook,'status':'Passed'} for hook in m['expected_hook_names']]
+    times={x['name'][0]:x['elapsed_seconds'] for x in record['commands'] if x['name'].endswith('-aggregate')}
+    gain=times['A']-times['B'];percent=100*gain/times['A'];numeric=times['B']<times['A'] and gain>=.5 and percent>=5.0
+    return {'state':'SCOPED_NET_MEASUREMENT_COLLECTED','order':['B','A'],'aggregate_seconds':times,'reduction_seconds':gain,'reduction_percent':percent,'numeric_gate_passed':numeric,'disposition':'PROVISIONAL_NUMERIC_NET_BENEFIT_ROOT_JUDGMENT_REQUIRED' if numeric else 'NO CHANGE','root_interference_judgment_required':True,'single_pair_variance_not_established':True,'cold_bootstrap_and_full_SelfTest_included':True,'B_new109_test_cost_included':True,'cleanup_separate':True,'resampling':False,'committed_endpoint_audit_acceptance_not_established':True}
