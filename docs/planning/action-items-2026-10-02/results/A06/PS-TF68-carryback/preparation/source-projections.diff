+        if ($null -ne $objPrimaryFailure) { $strFailure = $objPrimaryFailure.Exception.Message + "`n" + $strFailure }
+        throw $strFailure
+    }
+    if ($null -ne $objPrimaryFailure) { throw $objPrimaryFailure }
+}
