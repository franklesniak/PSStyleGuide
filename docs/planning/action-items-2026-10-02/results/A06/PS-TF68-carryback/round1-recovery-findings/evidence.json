  "comments": [
    {
      "id": 4201048162,
      "pull_request_review_id": 5435249947,
      "path": ".github/workflows/Test-AgentInstructions.ps1",
      "commit_id": "504cd7672ac9604ace765a4f451346f801f09ddd",
      "body": "The SHA256 identity computation and subsequent reflection/type-resolution work runs on every call when `-UseNativeStructuralConversion` is set. Since the template is constant, consider caching (at script scope) the computed identity, resolved `[type]`, and any reflected members used for verification/invocation so hot-path Markdown parsing avoids repeated hashing/reflection overhead while preserving the same correctness checks.",
      "start_line": 413,
      "line": 426,
      "html_url": "https://github.com/franklesniak/PSStyleGuide/pull/235#discussion_r4201048162"
    },
    {
      "id": 4201048196,
      "pull_request_review_id": 5435249947,
      "path": ".github/workflows/copilot-code-review.yml",
      "commit_id": "504cd7672ac9604ace765a4f451346f801f09ddd",
      "body": "This npm-environment sanitization block appears multiple times in the workflow (e.g., in the verification, install, and dependency-tree steps). Duplicating this logic increases the chance of future drift (one step updated while others aren\u2019t). Consider moving the sanitization into a single repo-owned helper script (bash) that each step calls, or using a single step that exports the sanitized env values and a reusable command wrapper, so policy changes stay consistent across all npm invocations.",
      "start_line": 572,
      "line": 600,
      "html_url": "https://github.com/franklesniak/PSStyleGuide/pull/235#discussion_r4201048196"
    }
  ],
