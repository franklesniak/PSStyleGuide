  "comments": {
    "4191973425": {
      "id": 4191973425,
      "path": ".github/workflows/Test-AgentInstructions.SelfTest.ps1",
      "line": 949,
      "body": "`Set-PSBreakpoint -Script` is being passed a wildcard pattern (escaped path). In some PowerShell versions, the resulting breakpoint\u2019s `.Script` field can reflect the pattern rather than the literal path. Later checks in this self-test compare breakpoint `.Script` against the unescaped `$CheckerPath`, which can produce false failures even when the breakpoint targets the correct file. Consider normalizing the comparison to accept both the escaped pattern and the literal resolved path (or compare using wildcard matching against `$CheckerPath`) to make the verification robust.",
      "commit_id": "3b12700eb636da67f5861637e5b139a18fa82140"
    },
    "4191973454": {
      "id": 4191973454,
      "path": ".github/workflows/Test-AgentInstructions.SelfTest.ps1",
      "line": 1001,
      "body": "`Set-PSBreakpoint -Script` is being passed a wildcard pattern (escaped path). In some PowerShell versions, the resulting breakpoint\u2019s `.Script` field can reflect the pattern rather than the literal path. Later checks in this self-test compare breakpoint `.Script` against the unescaped `$CheckerPath`, which can produce false failures even when the breakpoint targets the correct file. Consider normalizing the comparison to accept both the escaped pattern and the literal resolved path (or compare using wildcard matching against `$CheckerPath`) to make the verification robust.",
      "commit_id": "3b12700eb636da67f5861637e5b139a18fa82140"
    },
    "4191973471": {
      "id": 4191973471,
      "path": ".github/workflows/Test-CiHelpers.test.mjs",
      "line": 33,
      "body": "These tests hard-require `pwsh` and Git at fixed paths (`/usr/bin/git` or `C:\\\\Program Files\\\\Git\\\\bin\\\\git.exe`). That makes the Node test suite brittle for contributors running it on environments where PowerShell or Git are installed elsewhere (or not installed). Prefer feature-detecting required executables and skipping with a clear message when unavailable, or resolving Git/PowerShell via PATH for tests (keeping fixed-path enforcement to workflow-policy validation where it\u2019s actually required).",
      "commit_id": "3b12700eb636da67f5861637e5b139a18fa82140"
    },
    "4191973511": {
      "id": 4191973511,
      "path": ".github/workflows/Test-CiHelpers.test.mjs",
      "line": 65,
      "body": "These tests hard-require `pwsh` and Git at fixed paths (`/usr/bin/git` or `C:\\\\Program Files\\\\Git\\\\bin\\\\git.exe`). That makes the Node test suite brittle for contributors running it on environments where PowerShell or Git are installed elsewhere (or not installed). Prefer feature-detecting required executables and skipping with a clear message when unavailable, or resolving Git/PowerShell via PATH for tests (keeping fixed-path enforcement to workflow-policy validation where it\u2019s actually required).",
      "commit_id": "3b12700eb636da67f5861637e5b139a18fa82140"
    },
    "4191973543": {
      "id": 4191973543,
      "path": ".github/workflows/Test-StyleGuideArtifacts.ps1",
      "line": 564,
      "body": "`[System.IO.FileInfo]::new($strChannel).Length` throws if the channel file path is set but the file does not exist, which would bypass the intended fixed diagnostic and potentially leak an unstructured exception message. To keep failures deterministic, explicitly check existence (e.g., `Test-Path -LiteralPath`) before reading `.Length`, and throw a fixed `runner-state:` diagnostic if the file is missing or non-empty.",
      "commit_id": "3b12700eb636da67f5861637e5b139a18fa82140"
    }
  },
