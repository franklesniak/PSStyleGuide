          "            $hashtableRecord.TemporaryDisposition = 'ConsumedByReplace'",
          "        } else {",
          "            $hashtableRecord.PublicationMethod = 'File.Move'",
          "            [System.IO.File]::Move($strTemporaryPath, $strDestinationPath)",
