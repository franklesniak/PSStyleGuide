new file mode 100644
--- /dev/null
+++ b/.github/workflows/Assert-MaintenanceLabel.mjs
@@ -0,0 +1,56 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+export const approvalLabel = 'maintenance-approved';
+
+// This verifies one platform-provided event, not current remote state or human intent.
+// Labels on synchronize/edited events do not identify who originally applied them.
+export function assertMaintenanceLabel({ classification, event, eventName, repository,
+  base, head, runAttempt }) {
+  if (!['ordinary', 'maintenance_required'].includes(classification)) {
+    throw new Error('Unknown maintenance classification.');
+  }
+  if (eventName !== 'pull_request_target' || !/^[a-f0-9]{40}$/.test(base ?? '') ||
+      !/^[a-f0-9]{40}$/.test(head ?? '') ||
+      !/^franklesniak\/(PSStyleGuide|TerraformStyleGuide)$/.test(repository ?? '') ||
+      event?.repository?.full_name !== repository ||
+      event?.pull_request?.base?.repo?.full_name !== repository ||
+      event?.pull_request?.base?.sha !== base || event?.pull_request?.head?.sha !== head ||
+      event?.pull_request?.state !== 'open' || !Number.isSafeInteger(event?.number) ||
+      event.number <= 0 || event.pull_request.number !== event.number) {
+    throw new Error('Expected an open, matching repository and exact PR input.');
+  }
+  if (classification === 'ordinary') return 'ordinary';
+
+  const owner = event.repository.owner;
+  const sender = event.sender;
+  const label = event.label;
+  const labels = event.pull_request.labels;
+  if (runAttempt !== '1' || event.action !== 'labeled' ||
+      owner?.login !== 'franklesniak' || owner?.type !== 'User' ||
+      !Number.isSafeInteger(owner?.id) || owner.id <= 0 ||
+      sender?.id !== owner.id || sender?.login !== owner.login || sender?.type !== 'User' ||
+      label?.name !== approvalLabel || !Number.isSafeInteger(label?.id) || label.id <= 0 ||
+      !Array.isArray(labels) || labels.filter(item => item?.name === approvalLabel).length !== 1 ||
+      !labels.some(item => item?.id === label.id && item?.name === approvalLabel)) {
+    throw new Error('MAINTENANCE_REQUIRED: owner must freshly apply maintenance-approved to this PR input; retained labels and reruns do not prove approval.');
+  }
+  return 'owner-label-event';
+}
+
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  try {
+    if (process.argv.length !== 5) {
+      throw new Error('Usage: node Assert-MaintenanceLabel.mjs CLASSIFICATION BASE HEAD');
+    }
+    const event = JSON.parse(fs.readFileSync(process.env.GITHUB_EVENT_PATH, 'utf8'));
+    const result = assertMaintenanceLabel({ classification: process.argv[2], base: process.argv[3],
+      head: process.argv[4], event, eventName: process.env.GITHUB_EVENT_NAME,
+      repository: process.env.GITHUB_REPOSITORY, runAttempt: process.env.GITHUB_RUN_ATTEMPT });
+    process.stdout.write(`Maintenance admission: ${result}; exact-input review and merge gates still apply.\n`);
+  } catch (error) {
+    process.stderr.write(`Maintenance admission refused: ${error.message}\n`);
+    process.exitCode = 1;
+  }
+}
diff --git a/.github/workflows/Assert-MaintenanceLabel.test.mjs b/.github/workflows/Assert-MaintenanceLabel.test.mjs
new file mode 100644
--- /dev/null
+++ b/.github/workflows/Assert-MaintenanceLabel.test.mjs
@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { spawnSync } from 'node:child_process';
+import test from 'node:test';
+import { fileURLToPath } from 'node:url';
+import { assertMaintenanceLabel, approvalLabel } from './Assert-MaintenanceLabel.mjs';
+import { classifyInstructionMaintenance } from './Classify-InstructionMaintenance.mjs';
+
+const base = 'a'.repeat(40), head = 'b'.repeat(40);
+function fixture(repository = 'franklesniak/PSStyleGuide') {
+  return { classification: 'maintenance_required', eventName: 'pull_request_target',
+    repository, base, head, runAttempt: '1', event: {
+      action: 'labeled', number: 9,
+      repository: { full_name: repository, owner: { id: 41, login: 'franklesniak', type: 'User' } },
+      sender: { id: 41, login: 'franklesniak', type: 'User' },
+      label: { id: 81, name: approvalLabel },
+      pull_request: { number: 9, state: 'open', base: { sha: base, repo: { full_name: repository } },
+        head: { sha: head }, labels: [{ id: 81, name: approvalLabel }] },
+    } };
+}
+
+test('fresh owner label works in both repositories; classification remains separate', () => {
+  for (const repository of ['franklesniak/PSStyleGuide', 'franklesniak/TerraformStyleGuide']) {
+    const input = fixture(repository);
+    input.classification = classifyInstructionMaintenance({ base, head,
+      changedPaths: ['.github/workflows/Assert-MaintenanceLabel.mjs'] }).classification;
+    assert.equal(input.classification, 'maintenance_required');
+    assert.equal(assertMaintenanceLabel(input), 'owner-label-event');
+  }
+});
+
+test('ordinary documentation passes without a label; owner label does not exempt maintenance', () => {
+  const input = fixture();
+  input.classification = classifyInstructionMaintenance({ base, head, changedPaths: ['docs/example.md'] }).classification;
+  input.event.action = 'synchronize'; input.event.sender = { id: 99, login: 'contributor' };
+  input.event.pull_request.labels = []; delete input.event.label;
+  assert.equal(assertMaintenanceLabel(input), 'ordinary');
+  input.classification = classifyInstructionMaintenance({ base, head,
+    changedPaths: ['.github/workflows/agent-instructions.yml'] }).classification;
+  assert.throws(() => assertMaintenanceLabel(input), /MAINTENANCE_REQUIRED/);
+});
+
+const denied = {
+  'missing label': x => { x.event.pull_request.labels = []; },
+  'wrong label': x => { x.event.label.name = 'approved'; },
+  'case variant label': x => { x.event.label.name = 'Maintenance-Approved'; },
+  'different label identity': x => { x.event.label.id++; },
+  'duplicate label': x => { x.event.pull_request.labels.push({ ...x.event.label }); },
+  'non-owner applying actor': x => { x.event.sender = { id: 99, login: 'collaborator', type: 'User' }; },
+  'owner display name with different ID': x => { x.event.sender.id++; },
+  'bot actor': x => { x.event.sender.type = 'Bot'; },
+  'rerun of old approval payload': x => { x.runAttempt = '2'; },
+  'missing run attempt': x => { delete x.runAttempt; },
+  'changed head': x => { x.head = 'c'.repeat(40); },
+  'changed base': x => { x.base = 'c'.repeat(40); },
+  'wrong repository': x => { x.event.repository.full_name = 'attacker/PSStyleGuide'; },
+  'wrong base repository': x => { x.event.pull_request.base.repo.full_name = 'attacker/PSStyleGuide'; },
+  'closed PR': x => { x.event.pull_request.state = 'closed'; },
+  'PR number mismatch': x => { x.event.pull_request.number++; },
+  'unprivileged event mistaken for target': x => { x.eventName = 'pull_request'; },
+  'invalid endpoint': x => { x.base = 'main'; },
+  'unknown classification': x => { x.classification = 'approved'; },
+};
+for (const action of ['opened', 'reopened', 'synchronize', 'edited', 'unlabeled']) {
+  denied[`retained label on ${action} does not prove its applying actor`] = x => { x.event.action = action; };
+}
+for (const [name, mutate] of Object.entries(denied)) test(name, () => {
+  const input = fixture(); mutate(input); assert.throws(() => assertMaintenanceLabel(input));
+});
+
+test('synchronize payload is indistinguishable for owner-applied versus collaborator-applied retained label', () => {
+  const ownerHistory = fixture(); ownerHistory.event.action = 'synchronize'; delete ownerHistory.event.label;
+  const otherHistory = structuredClone(ownerHistory);
+  assert.deepEqual(ownerHistory, otherHistory);
+  assert.throws(() => assertMaintenanceLabel(ownerHistory), /freshly apply/);
+  assert.throws(() => assertMaintenanceLabel(otherHistory), /freshly apply/);
+});
+
+test('real CLI exits nonzero for refusal and malformed event, zero for owner event', t => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'option-l-cli-'));
+  t.after(() => { assert.equal(path.dirname(dir), os.tmpdir()); fs.rmSync(dir, { recursive: true, force: true }); });
+  const eventPath = path.join(dir, 'event.json');
+  const input = fixture();
+  const invoke = () => spawnSync(process.execPath, [fileURLToPath(new URL('./Assert-MaintenanceLabel.mjs', import.meta.url)),
+    input.classification, base, head], { encoding: 'utf8', windowsHide: true, timeout: 10000,
+    env: { ...process.env, GITHUB_EVENT_PATH: eventPath, GITHUB_EVENT_NAME: input.eventName,
+      GITHUB_REPOSITORY: input.repository, GITHUB_RUN_ATTEMPT: input.runAttempt } });
+  fs.writeFileSync(eventPath, JSON.stringify(input.event)); assert.equal(invoke().status, 0);
+  input.event.action = 'unlabeled'; fs.writeFileSync(eventPath, JSON.stringify(input.event));
+  assert.equal(invoke().status, 1);
+  fs.writeFileSync(eventPath, '{'); assert.equal(invoke().status, 1);
+});
