+++ b/.github/workflows/Validate-WorkflowPolicy.test.mjs
@@ -249,3 +249,49 @@
 test('obsolete catalog execution mode is rejected instead of silently claiming coverage', async () => {
   await assert.rejects(main(['--ordinary-case-catalog-data']), error => error.category === 'arguments');
 });
+
+// Option L's workflow wiring is tested with the accepted strict YAML parser.
+const optionLName = "${{ github.event_name == 'pull_request_target' && 'accepted-maintenance-policy' || 'accepted-maintenance-policy-not-applicable' }}";
+function assertOptionLWorkflow(value) {
+  assert.deepEqual(value.permissions, {});
+  for (const action of ['opened', 'reopened', 'synchronize', 'edited', 'labeled', 'unlabeled']) {
+    assert.ok(value.on.pull_request_target.types.includes(action));
+  }
+  const accepted = value.jobs['accepted-policy'];
+  assert.equal(accepted.name, optionLName);
+  assert.equal(accepted.if, "github.event_name == 'pull_request_target'");
+  assert.deepEqual(accepted.permissions, {});
+  assert.equal(accepted.concurrency['cancel-in-progress'], true);
+  assert.equal(accepted.concurrency.group, 'accepted-maintenance-${{ github.event.pull_request.number }}');
+  assert.ok(accepted.steps.every(item => !item.uses && !item['continue-on-error']));
+  assert.ok(!accepted['continue-on-error']);
+  const acquire = accepted.steps.find(item => item.id === 'acquire');
+  assert.equal(acquire.env.EXPECTED_BASE, '${{ github.event.pull_request.base.sha }}');
+  assert.ok(acquire.run.includes("checkout --quiet --detach $strRevision"));
+  const validate = accepted.steps.find(item => item.id === 'validate');
+  const gate = '& node .github/workflows/Assert-MaintenanceLabel.mjs $objResult.classification $env:EXPECTED_BASE $env:EXPECTED_HEAD';
+  assert.ok(validate.run.includes(gate + "\nif ($LASTEXITCODE -ne 0) { throw 'Accepted maintenance admission refused.' }"));
+  assert.ok(validate.run.indexOf(gate) > validate.run.indexOf('Classify-InstructionMaintenance.mjs'));
+  assert.ok(validate.run.indexOf(gate) < validate.run.indexOf("if ($objResult.classification -ceq 'ordinary')"));
+  assert.ok(!validate.run.includes('GITHUB_TOKEN:'));
+  const candidate = value.jobs['candidate-tests'];
+  assert.deepEqual(candidate.permissions, {});
+  assert.ok(candidate.if.startsWith("github.event_name != 'pull_request_target'"));
+  assert.ok(candidate.steps.find(item => item.id === 'test').run.includes('Assert-MaintenanceLabel.test.mjs'));
+}
+const optionLWorkflow = parseStrictYaml(fs.readFileSync(path.join(directory, 'agent-instructions.yml')), LIMITS).value;
+test('option L protects accepted-base invocation and separates skipped candidate check context', () => {
+  assertOptionLWorkflow(optionLWorkflow);
+});
+for (const [name, mutate] of [
+  ['missing revocation event', x => { x.on.pull_request_target.types = x.on.pull_request_target.types.filter(v => v !== 'unlabeled'); }],
+  ['skipped job reuses required context', x => { x.jobs['accepted-policy'].name = 'accepted-maintenance-policy'; }],
+  ['missing gate invocation', x => { x.jobs['accepted-policy'].steps.find(v => v.id === 'validate').run = 'Write-Output success'; }],
+  ['missing gate exit check', x => { const v = x.jobs['accepted-policy'].steps.find(v => v.id === 'validate'); v.run = v.run.replace("if ($LASTEXITCODE -ne 0) { throw 'Accepted maintenance admission refused.' }", ''); }],
+  ['candidate checkout mistaken for base', x => { x.jobs['accepted-policy'].steps[0].env.EXPECTED_BASE = '${{ github.event.pull_request.head.sha }}'; }],
+  ['credential grant', x => { x.jobs['accepted-policy'].permissions = { contents: 'write' }; }],
+  ['ignored refusal', x => { x.jobs['accepted-policy']['continue-on-error'] = true; }],
+  ['old concurrent result unsuppressed', x => { x.jobs['accepted-policy'].concurrency['cancel-in-progress'] = false; }],
+]) test('option L rejects workflow regression: ' + name, () => {
+  const value = clone(optionLWorkflow); mutate(value); assert.throws(() => assertOptionLWorkflow(value));
+});
