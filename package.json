{
  "name": "psstyleguide",
  "version": "1.0.0",
  "private": true,
  "description": "A style guide for consistent PowerShell authoring.",
  "license": "MIT",
  "engines": {
    "node": "24.18.1",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "bootstrap:agent-instructions": "node .github/workflows/NpmTools.mjs install",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/*.mdc\" \"#node_modules\" \"#.github/workflows/node_modules\" --config .github/workflows/.markdownlint.jsonc",
    "lint:md:nested": "npm --prefix .github/workflows run lint:md:nested",
    "test:agent-instructions": "pwsh -NoLogo -NoProfile -NonInteractive -File .github/workflows/Test-AgentInstructions.ps1 -SelfTest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franklesniak/PSStyleGuide.git"
  },
  "devDependencies": {
    "markdown-it": "14.3.2",
    "markdownlint-cli2": "0.23.3"
  },
  "overrides": {
    "markdownlint-cli2@0.23.3": {
      "markdown-it": "15.0.2"
    }
  }
}
