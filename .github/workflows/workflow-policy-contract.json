    "schema": "PSStyleGuide.ReciprocalFoundation.v1",
    "psRepository": "https://github.com/franklesniak/PSStyleGuide",
    "psCommit": "4346310e7deebffb4159c75e30d9546263dfd649",
    "psNormativeLocator": "https://github.com/franklesniak/PSStyleGuide/issues/145",
    "psNormativeSha256": "58ad9f1c705daef420c3d9b0aa113c59a3257f07d37fc641af254dd0cd0aa866",
    "terraformRepository": "https://github.com/franklesniak/TerraformStyleGuide",
    "terraformCommit": "6ee3f57b2b71b885a5927b770dde47532944de62",
    "terraformNormativeLocator": "https://github.com/franklesniak/TerraformStyleGuide/issues/20",
    "terraformNormativeSha256": "1f88627da6e9a5436898bf227dab6839afd90a16aa135e609619208c06fb08b3",
    "rows": [
      { "id": "GF-PARAMETERS", "status": "same", "observed": "Production generators expose no caller root/source/destination/output-map authority.", "rationale": "Both contracts close production authority over repository paths." },
      { "id": "GF-DESTINATION", "status": "intentional difference", "observed": "PS uses powershell.instructions.md; Terraform uses terraform.instructions.md.", "rationale": "Repository-specific leaves differ while containment, link, alias, and replacement guarantees remain equal." },
      { "id": "GF-CONTENT", "status": "intentional difference", "observed": "Language-specific frontmatter and labels differ.", "rationale": "Repository payload identity differs; complete-payload ordering and failure strength remain equal." },
      { "id": "GF-SERIALIZATION", "status": "same", "observed": "Both require final CR normalization and BOM-less UTF-8.", "rationale": "The byte boundary is symmetric." },
      { "id": "GF-WRITE", "status": "same", "observed": "CreateNew, Flush(true), verification, and one atomic publication rename with no fallback: File.Replace to an existing destination, File.Move to an absent one.", "rationale": "The transaction boundary is symmetric: publication is a single atomic rename with no fallback." },
      { "id": "GF-FAILURE", "status": "same", "observed": "Pre-replace cleanup and post-replace truth are explicit.", "rationale": "Neither contract claims cross-file atomicity or rollback." },
      { "id": "GF-HOSTS", "status": "same", "observed": "Windows PowerShell 5.1 and PowerShell 7 on Windows/Ubuntu are required.", "rationale": "Host equality and idempotence are symmetric." },
      { "id": "GF-VERSION", "status": "same", "observed": "The timeless four-component script-version profile is shared.", "rationale": "Grammar, expected identity, and authoring progression have equal strength." },
      { "id": "GF-NODE-LOCK", "status": "same", "observed": "Node 24.18.1/npm 11.16.0 solely produces the yaml@2.9.0 lock addition.", "rationale": "Producer and frozen-consumer contracts are symmetric." },
      { "id": "GF-YAML", "status": "same", "observed": "yaml@2.9.0 parses one strict YAML 1.2 core document offline.", "rationale": "Parser hazards and schema strictness are symmetric." },
      { "id": "GF-ACTION-PINS", "status": "same", "observed": "Checkout, setup-node, and upload-artifact use the same reviewed full SHAs.", "rationale": "Provenance and runtime pins are symmetric." },
      { "id": "GF-ACTION-INPUTS", "status": "intentional difference", "observed": "PS authors show-progress=true; Terraform plans show-progress=false.", "rationale": "Both are literal reviewed values with equal credential and failure containment; owners re-review on either action update." },
      { "id": "GF-GIT", "status": "intentional difference", "observed": "PS adds a reusable raw path verifier; Terraform plans equivalent raw gates inline.", "rationale": "NUL parsing and native status truth are equal; repository packaging differs." },
      { "id": "GF-GRAPH", "status": "intentional difference", "observed": "PS P1 is strictly read-only; Terraform T1 temporarily retains its pre-promotion writer.", "rationale": "PS has no publication requirement in P1; Terraform preserves current publication until T1B deletes it." },
      { "id": "GF-CREDENTIALS", "status": "intentional difference", "observed": "PS has no push credential; Terraform confines one credential to its temporary push child.", "rationale": "Absence is stronger for PS, while Terraform retains an expiring reviewed compatibility boundary until T1B." },
      { "id": "GF-EVIDENCE", "status": "intentional difference", "observed": "PS records read-only drift diagnostics; Terraform additionally requires temporary-writer drills.", "rationale": "Evidence follows each repository graph without weakening common cleanup or identity requirements." }
    ]
  }
