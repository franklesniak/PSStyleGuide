{
  "schema": "PSStyleGuide.WorkflowPolicyCases.v2",
  "cases": [
    {
      "name": "rejects privileged trigger",
      "workflow": "build.yml",
      "path": [
        "on",
        "pull_request_target"
      ],
      "operation": "set",
      "value": {},
      "category": "workflow-events"
    },
    {
      "name": "rejects workflow token permission",
      "workflow": "build.yml",
      "path": [
        "permissions"
      ],
      "operation": "set",
      "value": {
        "contents": "read"
      },
      "category": "workflow-permissions"
    },
    {
      "name": "rejects a global environment",
      "workflow": "build.yml",
      "path": [
        "env"
      ],
      "operation": "set",
      "value": {
        "TOKEN": "data"
      },
      "category": "workflow-shape"
    },
    {
      "name": "rejects code job token permission",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "permissions"
      ],
      "operation": "set",
      "value": {
        "contents": "read"
      },
      "category": "code-job-permissions"
    },
    {
      "name": "rejects code job dependency on privileged publication",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "needs"
      ],
      "operation": "set",
      "value": "publish_committed_artifacts",
      "category": "code-job-shape"
    },
    {
      "name": "rejects code job container injection",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "container"
      ],
      "operation": "set",
      "value": "image:latest",
      "category": "code-job-shape"
    },
    {
      "name": "rejects unlimited code job runtime",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "timeout-minutes"
      ],
      "operation": "set",
      "value": 0,
      "category": "code-job-execution"
    },
    {
      "name": "rejects additional code execution",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        3
      ],
      "operation": "set",
      "value": {
        "id": "extra",
        "shell": "pwsh",
        "run": "bad"
      },
      "category": "code-step-cardinality"
    },
    {
      "name": "rejects ignored helper failure",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        2,
        "continue-on-error"
      ],
      "operation": "set",
      "value": true,
      "category": "code-step-shape"
    },
    {
      "name": "rejects token projection in step",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        1,
        "env"
      ],
      "operation": "set",
      "value": {
        "TOKEN": "x"
      },
      "category": "code-step-shape"
    },
    {
      "name": "rejects candidate code action",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        0,
        "uses"
      ],
      "operation": "set",
      "value": "actions/checkout@main",
      "category": "code-step-shape"
    },
    {
      "name": "rejects empty acquisition",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        0,
        "run"
      ],
      "operation": "set",
      "value": "# only comment",
      "category": "acquisition-empty"
    },
    {
      "name": "rejects credential verification after generation",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        1,
        "id"
      ],
      "operation": "set",
      "value": "generate_style_guide_artifacts",
      "category": "code-step-interface"
    },
    {
      "name": "rejects arbitrary helper selection",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        2,
        "run"
      ],
      "operation": "set",
      "value": "./.github/workflows/Unsafe.ps1",
      "category": "helper-call"
    },
    {
      "name": "rejects extra helper argument",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        2,
        "run"
      ],
      "operation": "set",
      "value": "./.github/workflows/Test-StyleGuideArtifacts.ps1 -SkipChecks",
      "category": "helper-call"
    },
    {
      "name": "rejects expression injection",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        2,
        "run"
      ],
      "operation": "set",
      "value": "& (Get-Content ./selector)",
      "category": "helper-call"
    },
    {
      "name": "rejects helper followed by command",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "verify_generated_artifacts",
        "steps",
        2,
        "run"
      ],
      "operation": "set",
      "value": "./.github/workflows/Test-StyleGuideArtifacts.ps1; evil",
      "category": "helper-call"
    },
    {
      "name": "rejects publisher write permission",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "permissions"
      ],
      "operation": "set",
      "value": {
        "contents": "write"
      },
      "category": "publisher-permissions"
    },
    {
      "name": "rejects publishing before validation",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "needs"
      ],
      "operation": "set",
      "value": "other",
      "category": "publisher-execution"
    },
    {
      "name": "rejects candidate executable in publisher",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "steps",
        1,
        "run"
      ],
      "operation": "set",
      "value": "evil",
      "category": "publisher-step-shape"
    },
    {
      "name": "rejects mutable action reference",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "steps",
        0,
        "uses"
      ],
      "operation": "set",
      "value": "actions/checkout@main",
      "category": "action-identity"
    },
    {
      "name": "rejects persisted checkout credential",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "steps",
        0,
        "with",
        "persist-credentials"
      ],
      "operation": "set",
      "value": true,
      "category": "action-inputs"
    },
    {
      "name": "rejects arbitrary checkout revision",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "steps",
        0,
        "with",
        "ref"
      ],
      "operation": "set",
      "value": "main",
      "category": "action-inputs"
    },
    {
      "name": "rejects candidate generated artifact publication",
      "workflow": "build.yml",
      "path": [
        "jobs",
        "publish_committed_artifacts",
        "steps",
        1,
        "with",
        "path"
      ],
      "operation": "set",
      "value": "out/*",
      "category": "action-inputs"
    },
    {
      "name": "rejects missing locked dependency installation",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "policy",
        "steps",
        2,
        "run"
      ],
      "operation": "set",
      "value": "./.github/workflows/Initialize-CiToolchain.ps1",
      "category": "helper-call"
    },
    {
      "name": "rejects omitted workflow dependencies in the lint and audit job",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "markdownlint",
        "steps",
        2,
        "run"
      ],
      "operation": "set",
      "value": "./.github/workflows/Initialize-CiToolchain.ps1 -InstructionDependencies",
      "category": "helper-call"
    },
    {
      "name": "rejects omitted native exit check",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "policy",
        "steps",
        3,
        "run"
      ],
      "operation": "set",
      "value": "& node ./.github/workflows/Validate-WorkflowPolicy.mjs .github/workflows/build.yml .github/workflows/markdownlint.yml",
      "category": "helper-call"
    },
    {
      "name": "rejects swallowed native failure",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "policy",
        "steps",
        3,
        "run"
      ],
      "operation": "set",
      "value": "& node ./.github/workflows/Validate-WorkflowPolicy.mjs .github/workflows/build.yml .github/workflows/markdownlint.yml\nif ($LASTEXITCODE -ne 0) { Write-Output 'ignored' }",
      "category": "native-failure-check"
    },
    {
      "name": "rejects candidate supplied policy path",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "policy",
        "steps",
        3,
        "run"
      ],
      "operation": "set",
      "value": "& node ./candidate-policy.mjs .github/workflows/build.yml .github/workflows/markdownlint.yml\nif ($LASTEXITCODE -ne 0) { throw 'Workflow policy validation failed.' }",
      "category": "helper-call"
    },
    {
      "name": "rejects skipped lint step",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "markdownlint",
        "steps",
        3,
        "if"
      ],
      "operation": "set",
      "value": "false",
      "category": "code-step-shape"
    },
    {
      "name": "rejects missing audit failure propagation",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "markdownlint",
        "steps",
        4,
        "run"
      ],
      "operation": "set",
      "value": "& node ./.github/workflows/Check-NpmAudit.mjs",
      "category": "helper-call"
    },
    {
      "name": "rejects audit that ignores native findings",
      "workflow": "markdownlint.yml",
      "path": [
        "jobs",
        "markdownlint",
        "steps",
        4,
        "run"
      ],
      "operation": "set",
      "value": "& node ./.github/workflows/Check-NpmAudit.mjs\nWrite-Output 'ok'",
      "category": "native-failure-check"
    }
  ]
}
